{
  "name": "casepilot-agent",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @casepilot/api test",
    "test:setup": "node --test tests/setup/*.test.mjs && node --experimental-transform-types --test tests/setup/*.test.ts",
    "model:probe": "pnpm --filter @casepilot/api model:probe",
    "smoke": "node scripts/smoke.mjs",
    "smoke:isolated": "node scripts/smoke-isolated.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:status": "docker compose ps",
    "db:stop": "docker compose stop postgres"
  }
}
