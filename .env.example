# Local PostgreSQL (Docker exposes only the loopback address).
POSTGRES_DB=casepilot
POSTGRES_USER=casepilot
POSTGRES_PASSWORD=casepilot_dev_only
POSTGRES_PORT=15432
DATABASE_URL=postgresql://casepilot:casepilot_dev_only@127.0.0.1:15432/casepilot

# One standard BigModel API key is used for both model roles.
# Fill the real key only in .env. Never commit or paste it into chat.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CHAT_MODEL=glm-4.7-flash
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024

# Per-analysis budgets; model calls include report sections and repairs.
MODEL_TIMEOUT_MS=30000
MAX_MODEL_CALLS=8
MAX_RETRIEVAL_CALLS=3
RETRIEVAL_TOP_K=4
