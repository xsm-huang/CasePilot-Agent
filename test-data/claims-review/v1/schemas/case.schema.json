{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:casepilot:claims-review:v1:case",
  "title": "已结案车险审查输入档案",
  "description": "业务异常可以合法输入；引用完整性另作语义校验。禁止在输入中夹带标准答案。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dictionaryVersion": {
      "const": "1.0.0"
    },
    "datasetCaseId": {
      "$ref": "urn:casepilot:claims-review:v1:common#/$defs/datasetCaseId"
    },
    "caseRevision": {
      "$ref": "urn:casepilot:claims-review:v1:common#/$defs/revision"
    },
    "isSynthetic": {
      "const": true
    },
    "preparedAt": {
      "$ref": "urn:casepilot:claims-review:v1:common#/$defs/timestamp"
    },
    "reviewScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetClaimIds": {
          "type": "array",
          "items": {
            "$ref": "urn:casepilot:claims-review:v1:common#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "relatedClaimIds": {
          "$ref": "urn:casepilot:claims-review:v1:common#/$defs/ids"
        },
        "lossTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "own_vehicle",
              "third_party_vehicle"
            ]
          }
        },
        "scopeLimitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "targetClaimIds",
        "relatedClaimIds",
        "lossTypes",
        "scopeLimitations"
      ]
    },
    "accident": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accidentId": {
          "$ref": "urn:casepilot:claims-review:v1:common#/$defs/id"
        },
        "occurredAt": {
          "anyOf": [
            {
              "$ref": "urn:casepilot:claims-review:v1:common#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "liabilityDescription": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceRefs": {
          "$ref": "urn:casepilot:claims-review:v1:common#/$defs/ids"
        }
      },
      "required": [
        "accidentId",
        "occurredAt",
        "location",
        "description",
        "liabilityDescription",
        "evidenceRefs"
      ]
    },
    "parties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/party"
      },
      "minItems": 0
    },
    "vehicles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vehicle"
      },
      "minItems": 0
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      },
      "minItems": 0
    },
    "endorsements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/endorsement"
      },
      "minItems": 0
    },
    "losses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/loss"
      },
      "minItems": 0
    },
    "calculations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/calculation"
      },
      "minItems": 0
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      },
      "minItems": 0
    },
    "payments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/payment"
      },
      "minItems": 0
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      },
      "minItems": 0
    },
    "dataGaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      },
      "minItems": 0
    },
    "knowledgeRefs": {
      "type": "array",
      "items": {
        "$ref": "urn:casepilot:claims-review:v1:common#/$defs/clauseRef"
      },
      "minItems": 0
    },
    "injury": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "declaredStatus": {
          "$ref": "urn:casepilot:claims-review:v1:common#/$defs/declaredInjuryStatus"
        },
        "evidenceRefs": {
          "$ref": "urn:casepilot:claims-review:v1:common#/$defs/ids"
        },
        "injuredPersons": {
          "type": "array",
