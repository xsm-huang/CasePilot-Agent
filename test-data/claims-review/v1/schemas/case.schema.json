            "type": "object",
            "additionalProperties": false,
            "properties": {
              "partyId": {
                "$ref": "urn:casepilot:claims-review:v1:common#/$defs/id"
              },
              "vehicleId": {
                "anyOf": [
                  {
                    "$ref": "urn:casepilot:claims-review:v1:common#/$defs/id"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "relationship": {
                "$ref": "urn:casepilot:claims-review:v1:common#/$defs/personRelationship"
              },
              "evidenceRefs": {
                "$ref": "urn:casepilot:claims-review:v1:common#/$defs/ids"
              }
            },
            "required": [
              "partyId",
              "vehicleId",
              "relationship",
              "evidenceRefs"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "declaredStatus",
        "evidenceRefs",
        "injuredPersons"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "dictionaryVersion",
    "datasetCaseId",
    "caseRevision",
    "isSynthetic",
    "preparedAt",
    "reviewScope",
    "accident",
    "parties",
    "vehicles",
    "claims",
    "policies",
    "endorsements",
    "losses",
    "calculations",
    "approvals",
    "payments",
    "documents",
    "evidence",
    "observations",
    "dataGaps",
    "knowledgeRefs",
    "injury"
  ],
